# Throwaway credentials for the LOCAL observability POC only.
#
# Copy to docker/observability/.env.poc and replace every value with locally
# generated randomness:
#
#   cd docker/observability
#   sed -e "s|__S3_SECRET__|$(openssl rand -hex 24)|" \
#       -e "s|__CH_PASSWORD__|$(openssl rand -hex 24)|" \
#       -e "s|__CH_RESEARCH__|$(openssl rand -hex 24)|" \
#       -e "s|__ES_PASSWORD__|$(openssl rand -hex 24)|" \
#       -e "s|__GF_PASSWORD__|$(openssl rand -hex 24)|" \
#       poc/env.poc.example > .env.poc
#
# .env.poc is gitignored. Never put a production credential in it: this stack
# has no production peer and nothing here is rotated.

S3_ACCESS_KEY=finance-poc
S3_SECRET_KEY=__S3_SECRET__

CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=__CH_PASSWORD__
CLICKHOUSE_RESEARCH_PASSWORD=__CH_RESEARCH__

ELASTIC_PASSWORD=__ES_PASSWORD__
GRAFANA_PASSWORD=__GF_PASSWORD__

# Stands in for the immutable deployed SHA on synthetic events.
LOADGEN_SERVICE_VERSION=0000000000000000000000000000000000000000
