{
  "annotations": {"list": []},
  "description": "Production Linux host and monitored process runtime: file descriptors, virtual/resident memory, RAM, swap, committed memory, page faults, CPU, filesystem, inodes, load, and network.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "max(up{job=\"finance-node\"})", "legendFormat": "up", "refId": "A"}],
      "title": "Host Metrics Up", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 4, "y": 0}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "node_filefd_allocated{job=\"finance-node\"}", "legendFormat": "allocated", "refId": "A"}],
      "title": "Host Allocated FDs", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 90}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 8, "y": 0}, "id": 3,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"finance-node\"} / node_memory_MemTotal_bytes{job=\"finance-node\"})", "legendFormat": "RAM", "refId": "A"}],
      "title": "RAM Used", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 50}, {"color": "red", "value": 80}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 12, "y": 0}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * (node_memory_SwapTotal_bytes{job=\"finance-node\"} - node_memory_SwapFree_bytes{job=\"finance-node\"}) / clamp_min(node_memory_SwapTotal_bytes{job=\"finance-node\"}, 1)", "legendFormat": "swap", "refId": "A"}],
      "title": "Swap Used", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 80}, {"color": "red", "value": 100}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 16, "y": 0}, "id": 5,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * node_memory_Committed_AS_bytes{job=\"finance-node\"} / clamp_min(node_memory_CommitLimit_bytes{job=\"finance-node\"}, 1)", "legendFormat": "committed", "refId": "A"}],
      "title": "Committed Virtual Memory", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 4, "x": 20, "y": 0}, "id": 6,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "node_load1{job=\"finance-node\"}", "legendFormat": "load1", "refId": "A"}],
      "title": "Load 1m", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4}, "id": 7,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * sum by (groupname) (rate(namedprocess_namegroup_cpu_seconds_total{job=\"finance-process\"}[$__rate_interval]))", "legendFormat": "{{groupname}}", "refId": "A"}],
      "title": "Process CPU Usage", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4}, "id": 8,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (groupname) (namedprocess_namegroup_memory_bytes{job=\"finance-process\", memtype=\"resident\"})", "legendFormat": "{{groupname}}", "refId": "A"}],
      "title": "Process Resident Memory", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4}, "id": 9,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (groupname) (rate(namedprocess_namegroup_read_bytes_total{job=\"finance-process\"}[$__rate_interval]))", "legendFormat": "{{groupname}} read", "refId": "A"}, {"expr": "sum by (groupname) (rate(namedprocess_namegroup_write_bytes_total{job=\"finance-process\"}[$__rate_interval]))", "legendFormat": "{{groupname}} write", "refId": "B"}],
      "title": "Process Disk I/O", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12}, "id": 10,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_filefd_allocated{job=\"finance-node\"}", "legendFormat": "allocated", "refId": "A"}, {"expr": "node_filefd_maximum{job=\"finance-node\"}", "legendFormat": "kernel maximum", "refId": "B"}],
      "title": "Host File Descriptor Capacity", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12}, "id": 11,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_memory_Committed_AS_bytes{job=\"finance-node\"}", "legendFormat": "committed", "refId": "A"}, {"expr": "node_memory_CommitLimit_bytes{job=\"finance-node\"}", "legendFormat": "commit limit", "refId": "B"}, {"expr": "node_memory_MemTotal_bytes{job=\"finance-node\"}", "legendFormat": "physical RAM", "refId": "C"}],
      "title": "Host Virtual Memory Commit", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12}, "id": 12,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "rate(node_vmstat_pgfault{job=\"finance-node\"}[5m])", "legendFormat": "page faults/sec", "refId": "A"}, {"expr": "rate(node_vmstat_pgmajfault{job=\"finance-node\"}[5m])", "legendFormat": "major faults/sec", "refId": "B"}, {"expr": "rate(node_vmstat_pswpin{job=\"finance-node\"}[5m])", "legendFormat": "swap in/sec", "refId": "C"}, {"expr": "rate(node_vmstat_pswpout{job=\"finance-node\"}[5m])", "legendFormat": "swap out/sec", "refId": "D"}],
      "title": "Page Faults and Swap I/O", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 20}, "id": 13,
      "options": {"legend": {"calcs": ["lastNotNull", "min"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_memory_MemTotal_bytes{job=\"finance-node\"}", "legendFormat": "RAM total", "refId": "A"}, {"expr": "node_memory_MemAvailable_bytes{job=\"finance-node\"}", "legendFormat": "RAM available", "refId": "B"}, {"expr": "node_memory_SwapTotal_bytes{job=\"finance-node\"} - node_memory_SwapFree_bytes{job=\"finance-node\"}", "legendFormat": "swap used", "refId": "C"}],
      "title": "Physical and Swap Memory", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 20}, "id": 14,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"finance-node\", mode=\"idle\"}[5m])))", "legendFormat": "CPU busy", "refId": "A"}],
      "title": "Host CPU Usage", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 20}, "id": 15,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "node_load1{job=\"finance-node\"}", "legendFormat": "1m", "refId": "A"}, {"expr": "node_load5{job=\"finance-node\"}", "legendFormat": "5m", "refId": "B"}, {"expr": "node_load15{job=\"finance-node\"}", "legendFormat": "15m", "refId": "C"}],
      "title": "System Load", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 28}, "id": 16,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (1 - node_filesystem_avail_bytes{job=\"finance-node\", fstype!~\"tmpfs|overlay|squashfs\"} / node_filesystem_size_bytes{job=\"finance-node\", fstype!~\"tmpfs|overlay|squashfs\"})", "legendFormat": "{{mountpoint}}", "refId": "A"}],
      "title": "Filesystem Space Used", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"max": 100, "min": 0, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 28}, "id": 17,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "100 * (1 - node_filesystem_files_free{job=\"finance-node\", fstype!~\"tmpfs|ramfs|overlay|squashfs\"} / clamp_min(node_filesystem_files{job=\"finance-node\", fstype!~\"tmpfs|ramfs|overlay|squashfs\"}, 1))", "legendFormat": "{{mountpoint}}", "refId": "A"}],
      "title": "Filesystem Inodes Used", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 28}, "id": 18,
      "options": {"legend": {"calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "rate(node_network_receive_bytes_total{job=\"finance-node\", device!~\"lo|veth.*|br-.*|docker.*\"}[5m])", "legendFormat": "{{device}} receive", "refId": "A"}, {"expr": "rate(node_network_transmit_bytes_total{job=\"finance-node\", device!~\"lo|veth.*|br-.*|docker.*\"}[5m])", "legendFormat": "{{device}} transmit", "refId": "B"}],
      "title": "Host Network I/O", "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["finance", "production", "host", "file-descriptors", "virtual-memory"],
  "templating": {"list": [{"name": "DS_PROMETHEUS", "label": "Datasource", "type": "datasource", "query": "prometheus", "refresh": 1}]},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "Finance Host, FD & Virtual Memory",
  "uid": "finance-host-runtime",
  "version": 1
}
