{
  "annotations": {"list": []},
  "description": "Production PostgreSQL/TimescaleDB health by domain/database. Trading maps to the physical postgres database; English maps to english.",
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}, "id": 1,
      "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "max(up{job=\"finance-postgres\"})", "legendFormat": "up", "refId": "A"}],
      "title": "PostgreSQL Exporter Up", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}, "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(pg_stat_database_numbackends{job=\"finance-postgres\", datname=~\"$database\"})", "legendFormat": "connections", "refId": "A"}],
      "title": "Active Backends", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}, "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(pg_database_size_bytes{job=\"finance-postgres\", datname=~\"$database\"})", "legendFormat": "size", "refId": "A"}],
      "title": "Database Size", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"color": {"mode": "thresholds"}, "decimals": 2, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 95}]}, "unit": "percent"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}, "id": 4,
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "100 * sum(rate(pg_stat_database_blks_hit{job=\"finance-postgres\", datname=~\"$database\"}[5m])) / clamp_min(sum(rate(pg_stat_database_blks_hit{job=\"finance-postgres\", datname=~\"$database\"}[5m])) + sum(rate(pg_stat_database_blks_read{job=\"finance-postgres\", datname=~\"$database\"}[5m])), 0.001)", "legendFormat": "cache hit", "refId": "A"}],
      "title": "Cache Hit Ratio", "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4}, "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (datname) (rate(pg_stat_database_xact_commit{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} commit", "refId": "A"}, {"expr": "sum by (datname) (rate(pg_stat_database_xact_rollback{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} rollback", "refId": "B"}],
      "title": "Transactions / sec", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4}, "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "pg_stat_database_numbackends{job=\"finance-postgres\", datname=~\"$database\"}", "legendFormat": "{{datname}}", "refId": "A"}],
      "title": "Connections by Database", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4}, "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "pg_database_size_bytes{job=\"finance-postgres\", datname=~\"$database\"}", "legendFormat": "{{datname}}", "refId": "A"}],
      "title": "Size by Database", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12}, "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (datname) (rate(pg_stat_database_tup_inserted{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} inserted", "refId": "A"}, {"expr": "sum by (datname) (rate(pg_stat_database_tup_updated{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} updated", "refId": "B"}, {"expr": "sum by (datname) (rate(pg_stat_database_tup_deleted{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} deleted", "refId": "C"}],
      "title": "Row Changes / sec", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12}, "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (datname, mode) (pg_locks_count{job=\"finance-postgres\", datname=~\"$database\"})", "legendFormat": "{{datname}} / {{mode}}", "refId": "A"}],
      "title": "Locks", "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "${DS_PROMETHEUS}"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12}, "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"hideZeros": false, "mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (datname) (rate(pg_stat_database_deadlocks{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} deadlocks", "refId": "A"}, {"expr": "sum by (datname) (rate(pg_stat_database_temp_files{job=\"finance-postgres\", datname=~\"$database\"}[5m]))", "legendFormat": "{{datname}} temp files", "refId": "B"}],
      "title": "Deadlocks and Temp Files / sec", "type": "timeseries"
    }
  ],
  "refresh": "30s", "schemaVersion": 41,
  "tags": ["finance", "production", "postgresql", "timescaledb"],
  "templating": {"list": [
    {"name": "DS_PROMETHEUS", "label": "Datasource", "type": "datasource", "query": "prometheus", "refresh": 1},
    {"name": "database", "label": "Domain / Database", "type": "custom", "query": "Trading : postgres, English : english, Affiliate : affiliate, Affiliate Pipeline : affiliate_pipeline, User : users", "current": {"text": "Trading", "value": "postgres"}, "includeAll": true, "allValue": "affiliate|affiliate_pipeline|english|postgres|users", "multi": false, "options": []}
  ]},
  "time": {"from": "now-6h", "to": "now"}, "timezone": "browser",
  "title": "Finance PostgreSQL & TimescaleDB", "uid": "finance-postgres-prod", "version": 3
}
